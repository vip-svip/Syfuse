#!/sbin/sh
#
# update-binary —— KernelSU / Magisk 模块安装入口。
#
# 说明：这个文件是模块安装器的固定入口点，它会 source customize.sh。
# 标准实现由 KernelSU/Magisk 提供模板，此处采用官方模板的最小可靠版本。
#
# 注意 #!/sbin/sh：安装器运行时 /system 可能尚未挂载，
# 但 /sbin 一定可用，因此必须用 /sbin/sh 而非 /system/bin/sh。

#################
# Initialization
#################

umask 022

# 安装器会传入：$1 = 完整 ZIP 路径, $2 = ABI, $3 = API 级别
OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
[ -f /data/adb/ksu/bin/util_functions.sh ] && . /data/adb/ksu/bin/util_functions.sh

# 从 ZIP 中解压模块内容到当前目录（安装器已在模块目录下）
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2

# 执行模块自身的安装逻辑
[ -f "$MODPATH/customize.sh" ] && . "$MODPATH/customize.sh"

#################
# Finalization
#################

# 设置模块目录与文件的标准权限
set_perm_recursive "$MODPATH" 0 0 0755 0644

# 确保各脚本可执行（部分 ZIP 工具会丢失执行位）
set_perm "$MODPATH/customize.sh" 0 0 0755
set_perm "$MODPATH/post-fs-data.sh" 0 0 0755
set_perm "$MODPATH/service.sh" 0 0 0755
set_perm "$MODPATH/action.sh" 0 0 0755
set_perm "$MODPATH/uninstall.sh" 0 0 0755
