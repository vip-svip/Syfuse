# 统一换行与文本处理策略。
# 目的：跨平台协作时不产生整文件 diff，二进制产物不被 Git 做换行转换。
* text=auto eol=lf

# 需要保持 LF 的脚本（Android 端与 Linux 端执行）
*.sh text eol=lf
*.bash text eol=lf
*.awk text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.go text eol=lf
*.java text eol=lf

# 模块脚本必须是 LF，否则 KernelSU/Magisk 安装器无法执行
module/*.sh text eol=lf
module/META-INF/com/google/android/* text eol=lf

# Windows 侧脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制：禁止任何转换与 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.jar binary
*.aar binary
*.so binary
*.dex binary
*.apk binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.srs binary
*.mrs binary
*.mmdb binary

# 语言统计
*.kt linguist-language=Kotlin
*.kts linguist-language=Kotlin
