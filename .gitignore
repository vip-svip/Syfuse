# ---------- 构建产物 ----------
build/
.gradle/
.kotlin/
*.apk
*.aab
*.ap_
*.dex
*.class
dist/
# Go 内核产物
kernel/out/
# gomobile bind 的输出目录（AAR + 伴生 sources.jar，均为构建产物）
src/out/
*.aar
*.so
*.jar
# gomobile 的 -sources.jar 是 bind 的副产品，不是源码，不入库
!gradle/wrapper/gradle-wrapper.jar
# Go 构建缓存（正常应位于仓库外，这里兜底）
kernel/go-path/
kernel/go-cache/

# ---------- 本地配置与密钥（R5：绝不入库） ----------
local.properties
*.jks
*.keystore
*.p12
*.pfx
.env
.env.*
keystore.properties
signing.properties
secrets.properties
# 证书与私钥
*.pem
*.key
*.crt
!app/src/main/assets/ca/README.md

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/
*.hprof

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时 ----------
*.log
*.tmp
*.bak
*.orig
*.rej
crashlytics-build.properties

# ---------- Python / 工具缓存 ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 测试输出 ----------
tests/_artifacts/

# 注意：tests/perf_results.txt 与 tests/perf_apk_size.txt 是**故意入库**的。
# 它们是性能预算的原始证据，README 与 CHANGELOG 都引用它们。
# 忽略它们会让"实测值"变成无法核对的口头声明。
# 文件里记录了主机与 JVM 版本，因此不同机器的结果可以区分。

# ---------- 临时草稿（跑门禁/探测时的一次性产物）----------
# 这些是**过程产物**，不是证据。证据要按 2.10 第 6 条落到 docs/EVIDENCE.md。
# 落在仓库根而不是 /tmp，是因为本机 Git Bash 重定向到 /tmp 会静默丢内容
# （实测：命令成功但文件为空），所以只能在仓库内写。
/.gate_*.txt
/.vd_*.txt
/.timing.txt
/.apx_*
/.ev_*.txt
/.probe/
/.tmp_*
src/syfused.exe
